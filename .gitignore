node_modules/
out/
dist/
.vite/
coverage/

# Logs
*.log
make-log.txt
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
.env*.local
.mcp.json

# Build artefacts
*.tsbuildinfo

# Native WebView2 addon build output (node-gyp). The C++ source, binding.gyp and
# the vendored WebView2 SDK (include/ + lib/) ARE tracked; the generated build is not.
native/webview2-addon/build/

# Downloaded browser extensions — run `pnpm download:ublock` to populate
public/extensions/

# App user-data store (settings, profiles, sessions — local only, never commit)
aether-store.json

# Landing (Next.js build outputs — handled by landing/.gitignore but explicit here too)
landing/.next/
landing/out/
